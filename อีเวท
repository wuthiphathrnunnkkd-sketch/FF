btnWar.Text = "🔥 RUN WARHAWK (อีเวท) 🔥"
btnWar.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
btnWar.TextColor3 = Color3.new(1, 1, 0)
btnWar.Font = Enum.Font.SourceSansBold
btnWar.TextSize = 20

btnWar.MouseButton1Click:Connect(function()
    -- ดึงสคริปต์ Warhawk ต้นฉบับมาทำงานทันที
    loadstring(game:HttpGet("https://raw.githubusercontent.com/9v8v/Warhawk/main/Evade"))()
    btnWar.Text = "รันสำเร็จแล้ว!"
    btnWar.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
end)

