-- โค้ดเมนูรวม: ปรับความเร็ว + กระโดดสูง (ไม่มีระบบล็อค)
local sg = Instance.new("ScreenGui", game:GetService("CoreGui"))
local fr = Instance.new("Frame", sg)
fr.Size = UDim2.new(0, 220, 0, 170) -- ขยายขนาดหน้าต่างนิดหน่อย
fr.Position = UDim2.new(0.5, -110, 0.5, -85)
fr.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
fr.Active = true
fr.Draggable = true
Instance.new("UICorner", fr)

-- ช่องใส่ความเร็ว
local boxSpeed = Instance.new("TextBox", fr)
boxSpeed.Size = UDim2.new(0, 200, 0, 35)
boxSpeed.Position = UDim2.new(0, 10, 0, 10)
boxSpeed.PlaceholderText = "ใส่ความเร็ว (ปกติ 16)..."
boxSpeed.Text = "100"
boxSpeed.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
boxSpeed.TextColor3 = Color3.new(1, 1, 1)

-- ปุ่มกดปรับความเร็ว
local btnSpeed = Instance.new("TextButton", fr)
btnSpeed.Size = UDim2.new(0, 200, 0, 35)
btnSpeed.Position = UDim2.new(0, 10, 0, 50)
btnSpeed.Text = "ปรับความเร็ว"
btnSpeed.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
btnSpeed.TextColor3 = Color3.new(1, 1, 1)

-- ช่องใส่แรงกระโดด
local boxJump = Instance.new("TextBox", fr)
boxJump.Size = UDim2.new(0, 200, 0, 35)
boxJump.Position = UDim2.new(0, 10, 0, 90)
boxJump.PlaceholderText = "ใส่แรงกระโดด (ปกติ 50)..."
boxJump.Text = "100"
boxJump.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
boxJump.TextColor3 = Color3.new(1, 1, 1)

-- ปุ่มกดปรับแรงกระโดด
local btnJump = Instance.new("TextButton", fr)
btnJump.Size = UDim2.new(0, 200, 0, 35)
btnJump.Position = UDim2.new(0, 10, 0, 130)
btnJump.Text = "ปรับระยะกระโดด"
btnJump.BackgroundColor3 = Color3.fromRGB(255, 85, 0)
btnJump.TextColor3 = Color3.new(1, 1, 1)

-- ระบบทำงาน
btnSpeed.MouseButton1Click:Connect(function()
    local h = game.Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if h then h.WalkSpeed = tonumber(boxSpeed.Text) or 16 end
end)

btnJump.MouseButton1Click:Connect(function()
    local h = game.Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if h then h.JumpPower = tonumber(boxJump.Text) or 50 end
end)
