-- เมนูรวม: Speed + Jump + Fly + เสกดาบพื้นฐาน
local sg = Instance.new("ScreenGui", game:GetService("CoreGui"))
local fr = Instance.new("Frame", sg)
fr.Size = UDim2.new(0, 220, 0, 280) -- ขยายหน้าต่างเพิ่มปุ่มเสกดาบ
fr.Position = UDim2.new(0.5, -110, 0.5, -140)
fr.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
fr.Active = true
fr.Draggable = true
Instance.new("UICorner", fr)

-- (โค้ดส่วน Speed และ Jump เดิมของคุณ)
local lp = game.Players.LocalPlayer
local function getH() return lp.Character and lp.Character:FindFirstChildOfClass("Humanoid") end

local btnSpeed = Instance.new("TextButton", fr)
btnSpeed.Size = UDim2.new(0, 200, 0, 35)
btnSpeed.Position = UDim2.new(0, 10, 0, 10)
btnSpeed.Text = "SET SPEED (100)"
btnSpeed.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
btnSpeed.TextColor3 = Color3.new(1, 1, 1)
btnSpeed.MouseButton1Click:Connect(function() if getH() then getH().WalkSpeed = 100 end end)

local btnJump = Instance.new("TextButton", fr)
btnJump.Size = UDim2.new(0, 200, 0, 35)
btnJump.Position = UDim2.new(0, 10, 0, 50)
btnJump.Text = "SET JUMP (100)"
btnJump.BackgroundColor3 = Color3.fromRGB(255, 85, 0)
btnJump.TextColor3 = Color3.new(1, 1, 1)
btnJump.MouseButton1Click:Connect(function() if getH() then getH().UseJumpPower = true getH().JumpPower = 100 end end)

-- [ ส่วนเสริม: ปุ่มเสกดาบ ]
local btnSword = Instance.new("TextButton", fr)
btnSword.Size = UDim2.new(0, 200, 0, 50)
btnSword.Position = UDim2.new(0, 10, 0, 100)
btnSword.Text = "เสกดาบพื้นฐาน (Sword)"
btnSword.BackgroundColor3 = Color3.fromRGB(150, 0, 255)
btnSword.TextColor3 = Color3.new(1, 1, 1)

btnSword.MouseButton1Click:Connect(function()
    -- พยายามดึงดาบจาก LinkedSword (ดาบคลาสสิกของ Roblox)
    local sword = game:GetObjects("rbxassetid://125013769")[1] 
    if sword then
        sword.Parent = lp.Backpack
    else
        print("ไม่สามารถเสกดาบได้ในแมพนี้เนื่องจากระบบป้องกัน")
    end
end)

-- ปุ่มปิดเมนู (เพื่อความสะดวก)
local btnClose = Instance.new("TextButton", fr)
btnClose.Size = UDim2.new(0, 200, 0, 30)
btnClose.Position = UDim2.new(0, 10, 0, 240)
btnClose.Text = "ปิดเมนู"
btnClose.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
btnClose.TextColor3 = Color3.new(1, 1, 1)
btnClose.MouseButton1Click:Connect(function() sg:Destroy() end)
-- ปุ่มกดปรับแรงกระโดด
local btnJump = Instance.new("TextButton", fr)
btnJump.Size = UDim2.new(0, 200, 0, 35)
btnJump.Position = UDim2.new(0, 10, 0, 130)
btnJump.Text = "ปรับระยะกระโดด"
btnJump.BackgroundColor3 = Color3.fromRGB(255, 85, 0)
btnJump.TextColor3 = Color3.new(1, 1, 1)

-- ระบบทำงาน
btnSpeed.MouseButton1Click:Connect(function()
    local h = game.Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if h then h.WalkSpeed = tonumber(boxSpeed.Text) or 16 end
end)

btnJump.MouseButton1Click:Connect(function()
    local h = game.Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if h then h.JumpPower = tonumber(boxJump.Text) or 50 end
end)
